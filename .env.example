# ============================================================
# AI Discord Bot — environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit the real .env (it is listed in .gitignore).
# ============================================================

# --- Discord ------------------------------------------------
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# --- AI provider --------------------------------------------
# "openai", "gemini", or "custom" (any OpenAI-compatible service)
AI_PROVIDER=gemini

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini key: https://aistudio.google.com/apikey
# (GOOGLE_API_KEY is accepted as an alias)
GEMINI_API_KEY=

# Optional: override the default model for the chosen provider
#   openai -> gpt-4o-mini        gemini -> gemini-2.5-flash
AI_MODEL=

# --- Custom OpenAI-compatible provider (no VPN needed) ------
# Any service that speaks the OpenAI protocol works, e.g. B.AI (chat.b.ai),
# Z.ai/GLM, OpenRouter, a local LM Studio/Ollama server. Just set:
#   AI_PROVIDER=custom
#   AI_BASE_URL=https://api.b.ai/v1        <- the service's API base URL
#   AI_API_KEY=<key from that service>
#   AI_MODEL=glm-5.3-flash                 <- exact model id of that service

# --- Tunables (defaults shown; uncomment to change) ---------
# COMMAND_PREFIX=.
# AI_TEMPERATURE=0.7
# MAX_HISTORY_MESSAGES=40
# MAX_INPUT_CHARS=4000
# MAX_PROMPT_CHARS=1500
# AI_REQUEST_TIMEOUT=90
